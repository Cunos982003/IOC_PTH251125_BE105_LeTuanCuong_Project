#!/bin/sh
# Git executes hooks with sh; contract verification itself runs in PowerShell.
if git diff --cached --name-only | /usr/bin/grep -Eq '(^docs/contracts/|/src/test/resources/contracts/|^scripts/check-contracts.ps1$)'; then
    if command -v pwsh >/dev/null 2>&1; then
        exec pwsh -NoProfile -File scripts/check-contracts.ps1 -Staged
    else
        exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/check-contracts.ps1 -Staged
    fi
fi
