# =============================================================================
# Ride-Hailing & Logistics - Environment Variables Template
# Copy this file to .env and fill in the values, or run:
#   PowerShell: .\scripts\gen-env.ps1
# =============================================================================

# ---- BẮT BUỘC (Compose sẽ báo lỗi nếu thiếu) --------------------------------
# JWT_SECRET: base64 48-byte (96 ký tự) - dùng để ký/verify JWT token
# INTERNAL_KEY: hex 32-byte (64 ký tự) - dùng cho HTTP nội bộ /internal/**
JWT_SECRET=
INTERNAL_KEY=

# ---- POSTGRES (mặc định cho dev local; trên VPS PHẢI đặt trong .env) ---------
# Postgres superuser password (chỉ dùng lúc init volume lần đầu)
POSTGRES_PASSWORD=postgres-local-only

# Mật khẩu 4 role *_app (chỉ dùng lúc init volume lần đầu)
USER_DB_PASSWORD=user-local-only
LOCATION_DB_PASSWORD=location-local-only
DISPATCH_DB_PASSWORD=dispatch-local-only
PAYMENT_DB_PASSWORD=payment-local-only

# Cổng expose ra host (chỉ bind 127.0.0.1)
POSTGRES_PORT=5432

# ---- REDIS (mặc định cho dev local; trên VPS PHẢI đặt trong .env) ------------
REDIS_PASSWORD=redis-local-only
REDIS_PORT=6379

# ---- CORS cho api-gateway (phân tách bằng dấu phẩy, để trống = không bật) ----
CORS_ALLOWED_ORIGINS=

# ---- Tag image (mặc định local build) ----------------------------------------
IMAGE_TAG=local

# =============================================================================
# CÁCH SINH .env TỰ ĐỘNG (PowerShell):
#   .\scripts\gen-env.ps1
# Script sẽ:
#   - JWT_SECRET: base64 48 byte ngẫu nhiên
#   - INTERNAL_KEY: hex 32 byte ngẫu nhiên
#   - Các mật khẩu DB/Redis: hex 24 byte ngẫu nhiên
#   - KHÔNG ghi đè .env nếu đã tồn tại
# =============================================================================